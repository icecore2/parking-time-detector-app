<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_floating_zone_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_suggestion_box"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Row: Zone Badge, Type Pill, and Price Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Zone Number Pill -->
        <TextView
            android:id="@+id/tv_row_zone_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="1747"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Zone Type Pill (e.g. Loading zone, Parking Zone, Surface Lot) -->
        <TextView
            android:id="@+id/tv_row_zone_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Loading zone"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Cheapest Price Pill Badge (Vibrant Green for Free / Low Price) -->
        <TextView
            android:id="@+id/tv_row_price_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="FREE"
            android:textColor="@color/emerald_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Address / Description Line -->
    <TextView
        android:id="@+id/tv_row_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="5 Av SW , Fr 3 St SW To 4 St SW"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Metadata Details: Max Stay, Layout Type, Capacity, Enforcement -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_row_max_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ 20m max"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_row_stall_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="• Parallel"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_row_brz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="• Downtown"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Distance or Best Rate Tag -->
        <TextView
            android:id="@+id/tv_row_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cheapest nearby"
            android:textColor="@color/emerald_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
