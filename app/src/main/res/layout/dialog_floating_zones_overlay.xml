<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_zones_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Collapsible Mini Floating Pill Mode -->
    <LinearLayout
        android:id="@+id/layout_floating_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay_bubble"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_local_parking"
            android:tint="@color/emerald_green" />

        <TextView
            android:id="@+id/tv_floating_pill_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="FREE"
            android:textColor="@color/emerald_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="▼"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Expanded Draggable Card Window -->
    <LinearLayout
        android:id="@+id/layout_floating_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@drawable/bg_overlay_dialog"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="visible">

        <!-- Draggable Handle Bar Indicator -->
        <View
            android:id="@+id/view_floating_drag_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_local_parking"
                    android:tint="@color/emerald_green" />

                <TextView
                    android:id="@+id/tv_floating_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="CHEAPEST ZONES NEARBY"
                    android:textColor="@color/emerald_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Minimize Button -->
            <TextView
                android:id="@+id/btn_floating_minimize"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="Pill 🏷️"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Refresh Button -->
            <TextView
                android:id="@+id/btn_floating_refresh"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="⟳"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Close Button -->
            <TextView
                android:id="@+id/btn_floating_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_floating_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Showing parking zones ranked by lowest price"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Scrollable Dynamic Zones Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="320dp">

            <LinearLayout
                android:id="@+id/container_floating_zones_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
